{
  "name": "scrawl-technical-seo-aeo-crawler",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source crawler that generates a complete SEO, AEO and technical SEO audit report: scored, prioritized, and CI-ready.",
  "author": "Scrawl Contributors",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "turbo run build",
